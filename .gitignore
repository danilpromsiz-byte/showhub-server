# Ignore everything by default in root
/*

# Whitelist only what is needed for the cloud server
!/mediacenter/
!/requirements.txt
!/Procfile
!/render.yaml
!/Dockerfile
!/.gitignore
!/README.md
!/version.json
!/TvMediaApp/
!/.github/

# Ignore build artifacts and caches
TvMediaApp/.gradle/
TvMediaApp/**/build/
TvMediaApp/local.properties
TvMediaApp/.idea/
TvMediaApp/**/*.iml

# Inside mediacenter, ignore caches and temp files
**/__pycache__/
**/*.pyc
**/*.log
!/mediacenter/data/
!/mediacenter/data/users_stats.json

