# Ignore everything by default in root
/*

# Whitelist only what is needed for the cloud server
!/mediacenter/
!/requirements.txt
!/Procfile
!/render.yaml
!/Dockerfile
!/.gitignore
!/README.md
!/version.json
!/TvMediaApp/
!/pc-client/
!/tests/
!/.github/

# Ignore build artifacts and caches
TvMediaApp/.gradle/
TvMediaApp/**/build/
TvMediaApp/local.properties
TvMediaApp/.idea/
TvMediaApp/**/*.iml
TvMediaApp/app/src/main/jniLibs/
pc-client/bin/
pc-client/obj/
pc-client/publish/

# Inside mediacenter, ignore caches and temp files
**/__pycache__/
**/*.pyc
**/*.log
mediacenter/static/ShowHub-PC/
mediacenter/data/covers/
!/mediacenter/data/
!/mediacenter/data/users_stats.json
mediacenter/data/turso.json
mediacenter/data/supabase.json
*.env
.env*

